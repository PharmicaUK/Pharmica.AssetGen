<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The fixture apps restore Pharmica.AssetGen from the package the tests just built
       (.localnuget at the repo root) and everything else from nuget.org. -->
  <packageSources>
    <clear />
    <add key="local" value="../../../.localnuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="Pharmica.AssetGen" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
